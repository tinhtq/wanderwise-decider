# Copy to .env and adjust. .env is gitignored.

# AWS region for Bedrock.
AWS_REGION=us-east-1

# Any Bedrock text model id (or inference profile). Examples:
#   us.amazon.nova-pro-v1:0        (used in the demo)
#   us.amazon.nova-2-lite-v1:0
#   us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0

# Optional: cross-account IAM role the app assumes to call Bedrock.
# Leave empty to use the ambient credentials / instance role directly.
BEDROCK_ASSUME_ROLE_ARN=

# The local decision-model checkpoint served by `strands-decider serve`.
DECIDER_MODEL_ID=StrandsAgents/strands-decider-2B-hobson-v19

# Where the decider serve process is listening.
DECIDER_URL=http://127.0.0.1:8000
